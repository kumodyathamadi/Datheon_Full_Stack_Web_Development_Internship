# ATMOS Weather Telemetry - Environment Configuration
# Copy this file to .env and insert your real OpenWeatherMap API key.
# Note: Vite environment variables prefixed with VITE_ are embedded into the client-side bundle.
# For public production deployments requiring secret protection, use a serverless backend proxy.

# OpenWeatherMap API Key (Free tier from https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Default Weather Data Provider ('openweathermap' or 'openmeteo')
VITE_DEFAULT_WEATHER_PROVIDER=openweathermap
